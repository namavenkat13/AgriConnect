# AgriConnect Environment Configuration Template
# Copy this file to .env and provide your secret values.

# Server Port
PORT=3000

# Database Engine Configuration ('sqlite' or 'mysql')
DB_TYPE=sqlite
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=agriconnect

# Authentication Secret (Provide a strong random string for production)
JWT_SECRET=

# Twilio SMS API (Optional: leave empty to use built-in console logger fallback)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Sarvam AI Voice Agent Configuration (Optional: Outbound Voice Queue Alerts)
SARVAM_API_KEY=
SARVAM_ORG_ID=
SARVAM_WORKSPACE_ID=
SARVAM_AGENT_ID=
SARVAM_CONNECTION_ID=
SARVAM_AGENT_PHONE_NUMBER=
SARVAM_APP_VERSION=
AGRICONNECT_HELPLINE_NUMBER=
SARVAM_API_ENDPOINT=
