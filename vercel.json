{
  "version": 2,
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "rewrites": [
    { "source": "/api", "destination": "/api/index.js" },
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/dashboard", "destination": "/frontend/dashboard.html" },
    { "source": "/mandi", "destination": "/frontend/mandi.html" },
    { "source": "/admin", "destination": "/frontend/admin.html" },
    { "source": "/frontend/(.*)", "destination": "/frontend/$1" },
    { "source": "/", "destination": "/frontend/index.html" },
    { "source": "/(.*)", "destination": "/frontend/$1" }
  ]
}
